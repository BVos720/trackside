{
  "expo": {
    "name": "trackside",
    "slug": "brvs7200",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nl.branco.trackside",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Trackside adds your photos to a spot as reference shots, so you can see where to stand when you come back.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121722",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nl.branco.trackside",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trackside uses your location to show where you are at the circuit and work out when to leave for your next spot."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trackside adds your photos to a spot as reference shots, so you can see where to stand when you come back.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "792f2dac-9669-4e62-b8e8-2339220aa9e9"
      }
    },
    "owner": "brvs7200"
  }
}
