# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Windows / editors
.vs/
Thumbs.db

# Downloaded build tooling (pmtiles.exe is ~56MB and re-downloadable)
tools/

# Generated by `npm run tiles` — copies of assets/tiles/ for the web target
public/tiles/

# NOTE: assets/tiles/*.pmtiles IS committed. It is a few MB per venue and the
# app is useless without it in the Eifel dead zones (spec §1.4).

# NOTE: drizzle/ is deliberately NOT ignored. The generated migrations are
# checked-in schema history (spec §7) and must travel with the repository.

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
